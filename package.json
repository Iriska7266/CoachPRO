{
  "name": "coachpro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "node --env-file=.env scripts/dev.js",
    "start": "node --env-file=.env server/index.js",
    "build": "vite build",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file=.env tests/integration.js",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "db:seed": "node --env-file=.env server/seed.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  }
}
