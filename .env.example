# Copying is optional: node scripts/setup-env.js generates real secrets locally.
POSTGRES_DB=coachpro
POSTGRES_USER=coachpro
POSTGRES_PASSWORD=generate-with-setup
TEST_DB_PASSWORD=generate-with-setup
APP_ORIGIN=http://localhost:3000
PORT=3000
# Leave DATABASE_URL unset to use the local embedded PostgreSQL on port 54329.
# For Docker PostgreSQL: postgresql://coachpro:YOUR_PASSWORD@127.0.0.1:5432/coachpro
# DATABASE_URL=
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=generate-with-setup
# Optional real mail delivery (otherwise local development writes .local/mail/).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=CoachPRO <noreply@example.com>
# VAPID_PUBLIC_KEY=generated-by-setup
# VAPID_PRIVATE_KEY=generated-by-setup
# VAPID_SUBJECT=mailto:admin@example.com
